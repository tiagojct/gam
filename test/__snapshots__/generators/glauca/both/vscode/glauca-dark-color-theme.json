{
  "$schema": "vscode://schemas/color-theme",
  "name": "Glauca Profundum (Gam)",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#10161C",
    "editor.foreground": "#E8EEF2",
    "editor.lineHighlightBackground": "#171F2699",
    "editor.selectionBackground": "#2B4356CC",
    "editor.inactiveSelectionBackground": "#2B435666",
    "editor.findMatchBackground": "#3D97FF66",
    "editor.findMatchHighlightBackground": "#3D97FF33",
    "editor.wordHighlightBackground": "#8C8C8C33",
    "editorCursor.foreground": "#007AFF",
    "editorLineNumber.foreground": "#8C8C8C",
    "editorLineNumber.activeForeground": "#E8EEF2",
    "editorIndentGuide.background1": "#2A3540",
    "editorWhitespace.foreground": "#2A3540",
    "editorBracketMatch.border": "#3D97FF",
    "editorGutter.background": "#10161C",
    "editorWidget.background": "#171F26",
    "editorWidget.border": "#2A3540",
    "editorHoverWidget.background": "#171F26",
    "editorSuggestWidget.background": "#171F26",
    "editorSuggestWidget.selectedBackground": "#2B4356",
    "foreground": "#E8EEF2",
    "descriptionForeground": "#8C8C8C",
    "focusBorder": "#6CB2FF",
    "errorForeground": "#007AFF",
    "widget.shadow": "#10161C80",
    "selection.background": "#2B4356CC",
    "sideBar.background": "#171F26",
    "sideBar.foreground": "#E8EEF2",
    "sideBar.border": "#2A3540",
    "sideBarTitle.foreground": "#8C8C8C",
    "sideBarSectionHeader.background": "#171F26",
    "sideBarSectionHeader.foreground": "#E8EEF2",
    "activityBar.background": "#171F26",
    "activityBar.foreground": "#E8EEF2",
    "activityBar.inactiveForeground": "#8C8C8C",
    "activityBar.border": "#2A3540",
    "activityBar.activeBorder": "#3D97FF",
    "activityBarBadge.background": "#3D97FF",
    "activityBarBadge.foreground": "#0B1218",
    "statusBar.background": "#171F26",
    "statusBar.foreground": "#8C8C8C",
    "statusBar.border": "#2A3540",
    "statusBar.noFolderBackground": "#171F26",
    "statusBar.debuggingBackground": "#3D97FF",
    "statusBar.debuggingForeground": "#0B1218",
    "titleBar.activeBackground": "#171F26",
    "titleBar.activeForeground": "#E8EEF2",
    "titleBar.inactiveBackground": "#171F26",
    "titleBar.inactiveForeground": "#8C8C8C",
    "titleBar.border": "#2A3540",
    "tab.activeBackground": "#10161C",
    "tab.activeForeground": "#E8EEF2",
    "tab.inactiveBackground": "#171F26",
    "tab.inactiveForeground": "#8C8C8C",
    "tab.border": "#2A3540",
    "tab.activeBorderTop": "#3D97FF",
    "editorGroupHeader.tabsBackground": "#171F26",
    "editorGroupHeader.tabsBorder": "#2A3540",
    "editorGroup.border": "#2A3540",
    "panel.background": "#10161C",
    "panel.border": "#2A3540",
    "panelTitle.activeBorder": "#3D97FF",
    "panelTitle.activeForeground": "#E8EEF2",
    "panelTitle.inactiveForeground": "#8C8C8C",
    "list.activeSelectionBackground": "#2B4356",
    "list.activeSelectionForeground": "#E8EEF2",
    "list.inactiveSelectionBackground": "#2B435699",
    "list.hoverBackground": "#171F26",
    "list.highlightForeground": "#3D97FF",
    "list.focusOutline": "#6CB2FF",
    "input.background": "#10161C",
    "input.foreground": "#E8EEF2",
    "input.border": "#2A3540",
    "input.placeholderForeground": "#8C8C8C",
    "inputOption.activeBorder": "#3D97FF",
    "dropdown.background": "#171F26",
    "dropdown.foreground": "#E8EEF2",
    "dropdown.border": "#2A3540",
    "button.background": "#3D97FF",
    "button.foreground": "#0B1218",
    "button.hoverBackground": "#3D97FF",
    "button.secondaryBackground": "#171F26",
    "button.secondaryForeground": "#E8EEF2",
    "badge.background": "#3D97FF",
    "badge.foreground": "#0B1218",
    "progressBar.background": "#3D97FF",
    "textLink.foreground": "#3D97FF",
    "textLink.activeForeground": "#6CB2FF",
    "textPreformat.foreground": "#62BA46",
    "textBlockQuote.border": "#3D97FF",
    "scrollbarSlider.background": "#8C8C8C40",
    "scrollbarSlider.hoverBackground": "#8C8C8C66",
    "scrollbarSlider.activeBackground": "#8C8C8C80",
    "peekView.border": "#3D97FF",
    "peekViewEditor.background": "#171F26",
    "peekViewResult.background": "#171F26",
    "peekViewTitle.background": "#171F26",
    "notifications.background": "#171F26",
    "notifications.foreground": "#E8EEF2",
    "notifications.border": "#2A3540",
    "notificationCenterHeader.background": "#171F26",
    "quickInput.background": "#171F26",
    "quickInput.foreground": "#E8EEF2",
    "pickerGroup.foreground": "#3D97FF",
    "pickerGroup.border": "#2A3540",
    "menu.background": "#171F26",
    "menu.foreground": "#E8EEF2",
    "menu.selectionBackground": "#2B4356",
    "menu.selectionForeground": "#E8EEF2",
    "menu.border": "#2A3540",
    "breadcrumb.foreground": "#8C8C8C",
    "breadcrumb.focusForeground": "#E8EEF2",
    "breadcrumb.activeSelectionForeground": "#E8EEF2",
    "gitDecoration.modifiedResourceForeground": "#B184DB",
    "gitDecoration.addedResourceForeground": "#62BA46",
    "gitDecoration.deletedResourceForeground": "#007AFF",
    "gitDecoration.untrackedResourceForeground": "#62BA46",
    "gitDecoration.ignoredResourceForeground": "#8C8C8C",
    "diffEditor.insertedTextBackground": "#62BA4626",
    "diffEditor.removedTextBackground": "#007AFF26",
    "editorError.foreground": "#007AFF",
    "editorWarning.foreground": "#B184DB",
    "editorInfo.foreground": "#4A9EDB",
    "terminal.background": "#10161C",
    "terminal.foreground": "#E8EEF2",
    "terminalCursor.foreground": "#007AFF",
    "terminal.selectionBackground": "#2B4356CC",
    "terminal.ansiBlack": "#171F26",
    "terminal.ansiRed": "#B85F5F",
    "terminal.ansiGreen": "#4F9E3F",
    "terminal.ansiYellow": "#C79A3D",
    "terminal.ansiBlue": "#4981C4",
    "terminal.ansiMagenta": "#8E74AB",
    "terminal.ansiCyan": "#3F93A0",
    "terminal.ansiWhite": "#C6CED4",
    "terminal.ansiBrightBlack": "#3A4754",
    "terminal.ansiBrightRed": "#C96A6A",
    "terminal.ansiBrightGreen": "#62BA46",
    "terminal.ansiBrightYellow": "#D9AE4A",
    "terminal.ansiBrightBlue": "#007AFF",
    "terminal.ansiBrightMagenta": "#B184DB",
    "terminal.ansiBrightCyan": "#7FC4CF",
    "terminal.ansiBrightWhite": "#E8EEF2"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8C8C8C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#007AFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#62BA46"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#B184DB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#B184DB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#4A9EDB"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#45A3AD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator",
        "meta.annotation"
      ],
      "settings": {
        "foreground": "#C96A6A"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E8EEF2"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#C3CDD3"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#A7B1B8"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#86929A"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#007AFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C96A6A"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#007AFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#3D97FF"
      }
    },
    {
      "name": "Markup raw",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#62BA46"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#E8EEF2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E8EEF2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#62BA46"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#007AFF",
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#C3CDD3",
    "property": "#E8EEF2",
    "type": "#45A3AD",
    "class": "#45A3AD",
    "function": "#4A9EDB",
    "method": "#4A9EDB",
    "decorator": "#C96A6A",
    "enumMember": "#B184DB"
  }
}
