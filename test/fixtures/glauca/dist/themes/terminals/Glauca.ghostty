# Glauca (Pruina) — Ghostty theme (light). Generated from glauca.json.
# Colour only; needs Ghostty >= 1.3 for the search-* keys.
background = #f0f4f6
foreground = #16222a
cursor-color = #0b62cf
cursor-text = #f2f7fb
selection-background = #35576b
selection-foreground = #f2f7fb
search-foreground = #16222a
search-background = #b7cdd6
