{
  "name": "gam",
  "version": "0.1.0",
  "description": "Where the four Moby-Dick colour families meet: Pequod, Glauca, Try-Works and Ambergris, side by side, with an export tool.",
  "type": "module",
  "private": true,
  "scripts": {
    "vendor": "sh scripts/vendor.sh",
    "model": "node scripts/build-model.mjs",
    "render": "node scripts/render-pages.mjs",
    "og": "node scripts/build-og.mjs",
    "prebuild": "npm run model && npm run render && npm run og",
    "build": "vite build",
    "predev": "npm run model && npm run render",
    "dev": "vite",
    "preview": "vite preview",
    "pretest": "npm run model",
    "test": "vitest run"
  },
  "author": "Tiago Jacinto",
  "license": "MIT",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "js-yaml": "^5.4.2",
    "luaparse": "^0.3.1",
    "markdown-it": "^15.0.2",
    "plist": "^5.0.0",
    "smol-toml": "^1.8.0",
    "subset-font": "^2.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
